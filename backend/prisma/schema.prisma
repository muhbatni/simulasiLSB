// Prisma Schema sesuai Perancangan Skema Basis Data Relasional (Bab 3.1.4.2 D)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  mahasiswa
}

enum VerificationStatus {
  ASLI_VALID
  MANIPULASI_TERDETEKSI
  FORMAT_TIDAK_VALID
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(mahasiswa)
  createdAt    DateTime @default(now()) @map("created_at")

  events Event[]

  @@map("users")
}

model Event {
  id                String   @id @default(uuid())
  eventName         String   @map("event_name")
  eventDate         String   @map("event_date")
  organizer         String
  templateImagePath String?  @map("template_image_path")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  author       User          @relation(fields: [createdBy], references: [id])
  certificates Certificate[]

  @@map("events")
}

model Certificate {
  id                  String   @id @default(uuid())
  eventId             String   @map("event_id")
  certificateNumber   String   @unique @map("certificate_number")
  recipientName       String   @map("recipient_name")
  recipientIdentifier String   @map("recipient_identifier") // NIM atau Email
  recipientRole       String   @default("Peserta") @map("recipient_role")
  sha256Hash          String   @map("sha256_hash")
  stegoImagePath      String   @map("stego_image_path")
  mse                 Float    @default(0)
  psnr                Float    @default(0)
  issuedAt            DateTime @default(now()) @map("issued_at")

  event            Event             @relation(fields: [eventId], references: [id])
  verificationLogs VerificationLog[]

  @@map("certificates")
}

model VerificationLog {
  id                 String             @id @default(uuid())
  certificateId      String?            @map("certificate_id")
  certificateNumber  String?            @map("certificate_number")
  recipientName      String?            @map("recipient_name")
  ipAddress          String             @map("ip_address")
  verificationStatus VerificationStatus @map("verification_status")
  verifiedAt         DateTime           @default(now()) @map("verified_at")
  message            String

  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@map("verification_logs")
}
