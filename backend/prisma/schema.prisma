// Prisma Schema Basis Data Relasional E-Sertifikat LSB & SHA-256
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  mahasiswa
}

enum VerificationStatus {
  ASLI_VALID
  MANIPULASI_TERDETEKSI
  FORMAT_TIDAK_VALID
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(mahasiswa)
  createdAt    DateTime @default(now()) @map("created_at")

  events Event[]

  @@map("users")
}

model Event {
  id                String   @id @default(uuid())
  eventName         String   @map("event_name")
  eventDate         String   @map("event_date")
  startTime         String?  @map("start_time")
  endTime           String?  @map("end_time")
  organizer         String
  templateImagePath String?  @map("template_image_path")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  author       User          @relation(fields: [createdBy], references: [id])
  certificates Certificate[]

  @@map("events")
}

model Certificate {
  id                  String    @id @default(uuid())
  eventId             String    @map("event_id")
  certificateNumber   String    @unique @map("certificate_number")
  recipientName       String    @map("recipient_name")
  recipientIdentifier String    @map("recipient_identifier") // NIM atau Email
  recipientRole       String    @default("Peserta") @map("recipient_role")
  sha256Hash          String    @default("") @map("sha256_hash")
  canvasHash          String?   @map("canvas_hash")
  stegoImagePath      String?   @map("stego_image_path")
  coverImagePath      String?   @map("cover_image_path")
  status              String    @default("BELUM_TERBIT") @map("status") // BELUM_TERBIT / TERBIT / DICABUT
  mse                 Float     @default(0)
  psnr                Float     @default(0)
  tGenMs              Float?    @map("t_gen_ms")
  issuedAt            DateTime? @map("issued_at")

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  verificationLogs VerificationLog[]

  @@index([recipientIdentifier])
  @@index([eventId])
  @@map("certificates")
}

model VerificationLog {
  id                 String             @id @default(uuid())
  certificateId      String?            @map("certificate_id")
  certificateNumber  String?            @map("certificate_number")
  recipientName      String?            @map("recipient_name")
  ipAddress          String             @map("ip_address")
  verificationStatus VerificationStatus @map("verification_status")
  verifiedAt         DateTime           @default(now()) @map("verified_at")
  message            String
  tVerifMs           Float?             @map("t_verif_ms")
  detail             String?            @map("detail")
  storedHash         String?            @map("stored_hash")
  recomputedHash     String?            @map("recomputed_hash")

  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@index([verifiedAt])
  @@index([certificateNumber])
  @@map("verification_logs")
}
